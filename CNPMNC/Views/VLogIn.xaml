<Window x:Class="CNPMNC.VLogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CNPMNC"
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Title="Đăng nhập" Height="600" Width="1000">
     <Window.Resources>
          <Style TargetType="Image">
               <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"></Setter>
          </Style>
     </Window.Resources>
     <Grid Background="#FF125593">
          <Grid.ColumnDefinitions>
               <ColumnDefinition Width="1.3*"></ColumnDefinition>
               <ColumnDefinition></ColumnDefinition>
          </Grid.ColumnDefinitions>

          <!--Background màn login-->
          <Image Source="/Resources/Images/BackgroundLogIn.png"
                 Margin="80 100 40 100"/>

          <!--Login-->
          <Border Grid.Column="1" Margin="40 80 80 80"
                  Background="White" CornerRadius="20">
               <Grid>
                    <Grid.RowDefinitions>
                         <RowDefinition></RowDefinition>
                         <RowDefinition Height="2*"></RowDefinition>
                         <RowDefinition Height="20"></RowDefinition>
                         <RowDefinition></RowDefinition>
                         <RowDefinition Height="20"></RowDefinition>
                         <RowDefinition></RowDefinition>
                         <RowDefinition Height="30"></RowDefinition>
                         <RowDefinition></RowDefinition>
                         <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <!--Logo + Welcome-->
                    <Grid Grid.Row="1">
                         <Grid.ColumnDefinitions>
                              <ColumnDefinition></ColumnDefinition>
                              <ColumnDefinition Width="1.8*"></ColumnDefinition>
                         </Grid.ColumnDefinitions>
                         <Grid.RowDefinitions>
                              <RowDefinition Height="1.8*"></RowDefinition>
                              <RowDefinition></RowDefinition>
                         </Grid.RowDefinitions>

                         <Image Grid.Row="0" Grid.RowSpan="2" Margin="15 0 0 0"
                                Source="/Resources/Images/DucHaiLogo.png" />
                         <TextBlock Grid.Column="1" Grid.Row="0" Text="Chào mừng!"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    FontSize="25" FontWeight="Medium" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                                    Margin="0 0 20 5"/>
                         <TextBlock Grid.Column="1" Grid.Row="1" Text="Vui lòng nhập thông tin của bạn"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                    FontSize="11" Foreground="#FFB0AFAF" FontWeight="Regular"
                                    Margin="0 1.5 20 0" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>

                    </Grid>

                    <!--Username-->
                    <TextBlock Grid.Row="2" Text="Tên đăng nhập"
                               VerticalAlignment="Bottom" HorizontalAlignment="Right"
                               Margin="0 0 20 1" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"></TextBlock>
                    <Border Grid.Row="3" Margin="25 5 20 5"
                            BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                         <Grid Margin="2">
                              <TextBox Name="txtUserName" BorderThickness="0" VerticalContentAlignment="Center" 
                                       FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk" 
                                       Padding="3 0 0 0"
                                       TextChanged="txtUserName_TextChanged"></TextBox>
                              <TextBlock x:Name="txtPlaceHolderUserName" Text="Vui lòng nhập tên người dùng của bạn"
                                         VerticalAlignment="Center" Margin="5 0" Foreground="LightGray"
                                         FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk" IsHitTestVisible="False"></TextBlock>
                         </Grid>
                    </Border>

                    <!--Password-->
                    <TextBlock Grid.Row="4" Text="Mật khẩu"
                               VerticalAlignment="Bottom" HorizontalAlignment="Right"
                               Margin="0 0 20 1" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"></TextBlock>
                    <Border Grid.Row="5" Margin="25 5 20 5"
                            BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                         <Grid Margin="2">
                              <PasswordBox Name="pwBox" BorderThickness="0" VerticalContentAlignment="Center" 
                                           FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk" 
                                           Padding="3 0 0 0"
                                           PasswordChar="*" PasswordChanged="pwBox_PasswordChanged"/>
                              <TextBox Name="txtPW" BorderThickness="0" VerticalContentAlignment="Center" 
                                       FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk" 
                                       Padding="3 0 0 0"
                                       Visibility="Collapsed" TextChanged="txtPW_TextChanged"></TextBox>
                              <TextBlock x:Name="txtPlaceHolderPW" Text="******"
                                         VerticalAlignment="Center" Margin="5 0" Foreground="LightGray"
                                         FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk" IsHitTestVisible="False"></TextBlock>
                              <Image Name="btnHidePW" Source="/Resources/Images/eye.png" HorizontalAlignment="Right"
                                     Height="20" Margin="0 0 3 0" MouseDown="btnHidePW_MouseDown" Cursor="Hand"/>

                         </Grid>
                    </Border>

                    <!--Quên password-->
                    <CheckBox Grid.Row="6" Margin="0 0 0 0"
                              Content="Quên mật khẩu"
                              VerticalAlignment="Center" HorizontalAlignment="Center" 
                              FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk" Cursor="Hand"></CheckBox>
                    
                    <!--btn Đăng nhập-->
                    <Border x:Name="btnLogin" Grid.Row="7" Margin="25 5 20 10"
                            Background="#FF125593" CornerRadius="5" Cursor="Hand" MouseEnter="btnLogin_MouseEnter" MouseLeave="btnLogin_MouseLeave" MouseDown="btnLogin_MouseDown">
                         <!--<Button x:Name="btnLogin" Margin="2"
                                 BorderThickness="0" Background="Transparent"
                                 Content="Đăng nhập" Foreground="White" FontSize="13"
                                 FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"></Button>-->
                         <TextBlock Text="Đăng nhập"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    FontSize="12" Foreground="White"
                                    FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                                    IsHitTestVisible="False"></TextBlock>
                    </Border>

               </Grid>
          </Border>

     </Grid>
</Window>
