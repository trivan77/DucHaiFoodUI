<UserControl x:Class="CNPMNC.Views.Usercontrol.UCStaffList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CNPMNC.Views.Component.ForTable"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">
     <Grid Margin="0 15 0 0">
          <Grid.RowDefinitions>
               <RowDefinition Height="60"></RowDefinition>
               <RowDefinition></RowDefinition>
               <RowDefinition Height="60"></RowDefinition>
          </Grid.RowDefinitions>

          <!--Tìm kiếm và btn thêm mặt hàng-->
          <Grid>
               <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43"></ColumnDefinition>
                    <ColumnDefinition Width="300"></ColumnDefinition>
                    <ColumnDefinition Width="130"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="150"></ColumnDefinition>
                    <ColumnDefinition Width="55"></ColumnDefinition>
               </Grid.ColumnDefinitions>

               <TextBox Grid.Row="0" Grid.Column="1" Margin="0 10 10 10"
                        Style="{StaticResource SearchTextBoxStyle}"></TextBox>
               <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource MainButtonStyle}"
                       Margin="5 10" Content="Tìm kiếm"></Button>


               <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource MainButtonStyle}"
                       Content="+ Thêm người dùng" Margin="0 10"
                       Command="{Binding ShowAddStaffCommand}"></Button>
          </Grid>

          <!--List mặt hàng-->
          <Grid Grid.Row="1" Margin="43 0 55 0">
               <StackPanel>
                    <!-- Header -->
                    <Grid Background="#FF125593" Height="40">
                         <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="50"></ColumnDefinition>
                              <ColumnDefinition></ColumnDefinition>
                              <ColumnDefinition></ColumnDefinition>
                              <ColumnDefinition></ColumnDefinition>
                              <ColumnDefinition></ColumnDefinition>
                              <ColumnDefinition></ColumnDefinition>
                              <ColumnDefinition Width="150"></ColumnDefinition>
                              <ColumnDefinition Width="50"></ColumnDefinition>
                              <ColumnDefinition Width="16"></ColumnDefinition>
                         </Grid.ColumnDefinitions>
                         <TextBlock Grid.Column="1" Text="Họ và tên" Foreground="White" VerticalAlignment="Center"
                               FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk" />
                         <TextBlock Grid.Column="2" Text="Số điện thoại" Foreground="White" VerticalAlignment="Center"
                               FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"  />
                         <TextBlock Grid.Column="3" Text="Kho" Foreground="White" VerticalAlignment="Center"
                               FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"  />
                         <TextBlock Grid.Column="4" Text="SĐT" Foreground="White" VerticalAlignment="Center"
                               FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"  />
                         <TextBlock Grid.Column="5" Text="Ngày tuyển dụng" Foreground="White" VerticalAlignment="Center"
                               FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"  />
                         <TextBlock Grid.Column="6" Text="Chức vụ" Foreground="White" VerticalAlignment="Center"
                               FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"  />
                    </Grid>

                    <!-- Body -->
                    <ItemsControl ItemsSource="{Binding StaffListRows}">
                         <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                   <local:UCRowStaffList Margin="0 8 0 0" Height="40"/>
                              </DataTemplate>
                         </ItemsControl.ItemTemplate>
                    </ItemsControl>
               </StackPanel>
          </Grid>

          <Grid Grid.Row="2" Margin="43 0 55 0" Background="Transparent">
               
          </Grid>
     </Grid>
</UserControl>
