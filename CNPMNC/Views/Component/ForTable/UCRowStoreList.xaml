<UserControl x:Class="CNPMNC.Views.Component.ForTable.UCRowStoreList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CNPMNC.Views.Component.ForTable"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
     <Grid Background="#FFF7F7F7">
          <Grid.ColumnDefinitions>
               <ColumnDefinition Width="30"></ColumnDefinition>
               <ColumnDefinition></ColumnDefinition>
               <ColumnDefinition></ColumnDefinition>
               <ColumnDefinition></ColumnDefinition>
               <ColumnDefinition></ColumnDefinition>
               <ColumnDefinition></ColumnDefinition>
               <ColumnDefinition Width="100"></ColumnDefinition>
               <ColumnDefinition Width="16"></ColumnDefinition>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding STT}" VerticalAlignment="Center" Margin="13 0 5 0"
                     FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>
          <TextBlock Grid.Column="1" Text="{Binding TenKho}" VerticalAlignment="Center" Margin="13 0 5 0"
                     FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>
          <TextBlock Grid.Column="2" Text="{Binding DiaChi}" VerticalAlignment="Center" Margin="13 0 5 0"
                     FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>
          <TextBlock Grid.Column="3" Text="{Binding NgayTao}" VerticalAlignment="Center" Margin="13 0 5 0"
                     FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>
          <TextBlock Grid.Column="4" Text="{Binding TenPhuTrach}" VerticalAlignment="Center" Margin="13 0 5 0"
                     FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>
          <TextBlock Grid.Column="5" Text="{Binding SDTLienHe}" VerticalAlignment="Center" Margin="13 0 5 0"
                     FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>
          <Button Grid.Column="6" Content="..." 
                  FontSize="14" FontWeight="SemiBold" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                  Background="#FFF7F7F7" Foreground="#FF125593" BorderThickness="0">
               <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                         <MenuItem Header="Chỉnh sửa" Style="{StaticResource CustomMenuItemStyle}"
                                   Click="Edit_Click"
                                   CommandParameter="{Binding YourColumn1}" />
                         <MenuItem Header="Xóa" Style="{StaticResource CustomMenuItemStyle}"
                                   Click="Delete_Click"
                                   CommandParameter="{Binding YourColumn1}" />
                    </ContextMenu>
               </Button.ContextMenu>
          </Button>
     </Grid>
</UserControl>
