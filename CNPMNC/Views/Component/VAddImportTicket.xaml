<Window x:Class="CNPMNC.Views.Component.VAddImportTicket"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CNPMNC.Views.Component"
             xmlns:utils="clr-namespace:CNPMNC.Views.Component.ForTable"
             mc:Ignorable="d" 
             Height="600" Width="1200"
             ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Title="Phần mềm quản lý cửa hàng - Đức Hải Foods - Thêm phiếu nhập">
     <Grid>
          <Grid.RowDefinitions>
               <RowDefinition Height="40"></RowDefinition>
               <RowDefinition></RowDefinition>
          </Grid.RowDefinitions>

          <Grid.ColumnDefinitions>
               <ColumnDefinition></ColumnDefinition>
               <ColumnDefinition Width="2.5*"></ColumnDefinition>
          </Grid.ColumnDefinitions>


          <!--Tiêu đề-->
          <TextBlock Text="Thêm phiếu nhập" 
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="20 0 0 0"
                     FontSize="20" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                     FontWeight="Bold" Foreground="#FF125593"></TextBlock>

          <!--Button Thêm phiếu-->
          <Button Grid.Column="1" Content="+ Thêm phiếu"
                  Style="{StaticResource MainButtonStyle}"
                  HorizontalAlignment="Right"
                  Width="130" Margin="0 5 20 5"></Button>

          <!--Form input cho phiếu-->
          <Grid Grid.Row="1" Margin="20 0 0 0">
               <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="50"></RowDefinition>
                    <RowDefinition></RowDefinition>
               </Grid.RowDefinitions>

               <TextBlock Grid.Row="0" Text="Thông tin phiếu"
                          VerticalAlignment="Top"
                          FontSize="16" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                          FontWeight="Bold" Foreground="#FF125593"></TextBlock>
               <TextBlock Grid.Row="4" Text="Thông tin sản phẩm"
                          VerticalAlignment="Center"
                          FontSize="16" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                          FontWeight="Bold" Foreground="#FF125593"></TextBlock>

               <local:FloatingLabelTextBox x:Name="txtNgayTaoPhieu" Grid.Row="1"
                                           LabelText="Ngày tạo phiếu" IsEnabled="False"></local:FloatingLabelTextBox>
               <local:FloatingLabelTextBox x:Name="txtNguoiTaoPhieu" Grid.Row="3"
                                           LabelText="Người tạo phiếu" IsEnabled="False"></local:FloatingLabelTextBox>

               <local:FloatingLabelTextBox x:Name="txtCurrentStore" Grid.Row="5"
                                           LabelText="Kho hàng" IsEnabled="False"></local:FloatingLabelTextBox>
               <local:FloatingLabelComboBox x:Name="cbxTenSP" Grid.Row="7"
                                           LabelText="Tên mặt hàng"
                                            ItemsSource="{Binding DanhSachTenSP}"
                                            SelectedItem="{Binding ProductSelected}"></local:FloatingLabelComboBox>
               <local:FloatingLabelTextBox Grid.Row="9" x:Name="txtSoLuong"
                                           LabelText="Số lượng" Text="{Binding NumImported}"></local:FloatingLabelTextBox>

               <Grid Grid.Row="11">
                    <Grid.ColumnDefinitions>
                         <ColumnDefinition></ColumnDefinition>
                         <ColumnDefinition></ColumnDefinition>
                         <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>


                    <Button Grid.Column="0" Content="Thêm"
                            Style="{StaticResource MainButtonStyle}"
                            Width="90" Height="30"
                            HorizontalAlignment="Left"
                            Command="{Binding AddProductCommand}"></Button>
                    <Button Grid.Column="1" Content="Cập nhật"
                            Style="{StaticResource MainButtonStyle}"
                            Width="90" Height="30"
                            Background="#FF258DE4"
                            Command="{Binding UpdateProductCommand}"></Button>
                    <Button Grid.Column="2" Content="Xóa"
                            Style="{StaticResource CloseButtonStyle}"
                            Width="90" Height="30"
                            HorizontalAlignment="Right"
                            Command="{Binding DeleteProductCommand}"></Button>
               </Grid>

          </Grid>

          <!--Bảng sản phẩm-->
          <Grid Grid.Row="1" Grid.Column="1" Margin="20 0 20 0">
               <Grid.RowDefinitions>
                    <RowDefinition Height="425"></RowDefinition>
                    <RowDefinition></RowDefinition>
               </Grid.RowDefinitions>

               <!--List mặt hàng-->
               <Grid Grid.Row="0">
                    <StackPanel>
                         <!-- Header -->
                         <Grid Background="#FF125593" Height="40">
                              <Grid.ColumnDefinitions>
                                   <ColumnDefinition Width="50"></ColumnDefinition>
                                   <ColumnDefinition Width="0"></ColumnDefinition>
                                   <ColumnDefinition Width="1.3*"></ColumnDefinition>
                                   <ColumnDefinition Width="0.6*"></ColumnDefinition>
                                   <ColumnDefinition></ColumnDefinition>
                                   <ColumnDefinition></ColumnDefinition>
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="1" Text="Mã mặt hàng" Foreground="White" VerticalAlignment="Center"
                                         FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk" />
                              <TextBlock Grid.Column="2" Text="Tên mặt hàng" Foreground="White" VerticalAlignment="Center"
                                         FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk" />
                              <TextBlock Grid.Column="3" Text="Số lượng" Foreground="White" VerticalAlignment="Center"
                                         FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"  />
                              <TextBlock Grid.Column="4" Text="Giá nhập (VNĐ)" Foreground="White" VerticalAlignment="Center"
                                         FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"  />
                              <TextBlock Grid.Column="5" Text="Giá bán (VNĐ)" Foreground="White" VerticalAlignment="Center"
                                         FontSize="14" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"  />
                         </Grid>

                         <!-- Body -->
                         <ItemsControl ItemsSource="{Binding ProductImportRows}">
                              <ItemsControl.ItemTemplate>
                                   <DataTemplate>
                                        <utils:UCRowProductImport Margin="0 8 0 0" Height="40" RowClicked="UCRowProductImport_RowClicked"/>
                                   </DataTemplate>
                              </ItemsControl.ItemTemplate>
                         </ItemsControl>
                    </StackPanel>
               </Grid>

               <TextBlock Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                          FontSize="17" FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                          FontWeight="Bold" Foreground="#FF125593">
                    <Run Text="Tổng tiền: "></Run>
                    <Run Text="{Binding TotalPrice}" FontStyle="Italic"></Run>
                    <Run Text=" VNĐ"></Run>
               </TextBlock>

          </Grid>

     </Grid>
</Window>
