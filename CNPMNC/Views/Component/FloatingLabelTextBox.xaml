<UserControl x:Class="CNPMNC.Views.Component.FloatingLabelTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CNPMNC.Views.Component"
             x:Name="root"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
     <Grid>
          <!-- Viền bo tròn -->
          <Border BorderBrush="#FF718BAE" BorderThickness="1.5" Background="Transparent"/>

          <!-- TextBox -->
          <TextBox Text="{Binding Text, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Margin="10 5"
                   Background="Transparent"
                   BorderThickness="0"
                   FontSize="14" Foreground="#FF718BAE"
                   FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                   VerticalContentAlignment="Center"/>

          <!-- Label nổi -->
          <Label Content="{Binding LabelText, ElementName=root}"             
                 FontSize="13" FontWeight="Bold"              
                 Background="White" Foreground="#FF718BAE"  
                 FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                 Padding="2,0" Margin="10,-8,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top">
          </Label>
     </Grid>
</UserControl>
