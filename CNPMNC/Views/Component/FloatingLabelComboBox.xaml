<UserControl x:Class="CNPMNC.Views.Component.FloatingLabelComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CNPMNC.Views.Component"
             x:Name="root"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
     <Grid>

          <!-- ComboBox -->
          <ComboBox x:Name="partComboBox" ItemsSource="{Binding ItemsSource, ElementName=root}"
                    SelectedItem="{Binding SelectedItem, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Background="White"
                    BorderThickness="0"
                    FontSize="14" FontWeight="Bold" Foreground="#FF718BAE"
                    FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                    VerticalContentAlignment="Center"/>

          <!-- Label nổi -->
          <Label Content="{Binding LabelText, ElementName=root}"             
                 FontSize="13" FontWeight="Bold"
                 Background="White" Foreground="#FF718BAE"  
                 FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                 Padding="2,0" Margin="10,-8,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top">
          </Label>
     </Grid>
</UserControl>
