<Window x:Class="CNPMNC.Views.Component.VAddProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CNPMNC.Views.Component"
        mc:Ignorable="d"
        Title="Phần mềm quản lý cửa hàng - Đức Hải Foods - Thêm sản phẩm mới" Height="350" Width="850"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
     <Grid>
          <Grid.RowDefinitions>
               <RowDefinition Height="40"></RowDefinition>
               <RowDefinition Height="30"></RowDefinition>
               <RowDefinition Height="50"></RowDefinition>
               <RowDefinition Height="30"></RowDefinition>
               <RowDefinition Height="50"></RowDefinition>
               <RowDefinition Height="30"></RowDefinition>
               <RowDefinition Height="50"></RowDefinition>
               <RowDefinition></RowDefinition>
          </Grid.RowDefinitions>

          <Grid.ColumnDefinitions>
               <ColumnDefinition></ColumnDefinition>
               <ColumnDefinition></ColumnDefinition>
          </Grid.ColumnDefinitions>

          <!--Tiêu đề-->
          <TextBlock Grid.ColumnSpan="2" Text="Thêm sản phẩm" 
                     FontSize="20" FontWeight="Bold" Foreground="#FF125593"
                     FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                     HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

          <!--Form điền-->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên sản phẩm"
                     FontSize="15" FontWeight="Bold" Foreground="#FF125593"
                     FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="25 5 0 5"></TextBlock>
          <TextBox Grid.Row="2" Grid.Column="0" x:Name="txtTenSP" Style="{StaticResource InputTextBoxStyle}" Tag="Nhập tên sản phẩm"
                   Text="{Binding SanPhamAdded.TenSp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Margin="25 5"></TextBox>
          
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Loại sản phẩm"
                     FontSize="15" FontWeight="Bold" Foreground="#FF125593"
                     FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="25 5 0 5"></TextBlock>
          <ComboBox Name="cbxLoaiSanPham" Grid.Row="4" Grid.Column="0" Background="White" BorderBrush="#FF718BAE" Tag="Chọn giới tính"
                    FontSize="14" FontWeight="Bold" Foreground="#FF718BAE"
                    VerticalContentAlignment="Center"
                    FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                   SelectedItem="{Binding LoaiSPSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="25 5" Cursor="Hand"></ComboBox>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Đơn vị tính"
                     FontSize="15" FontWeight="Bold" Foreground="#FF125593"
                     FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="25 5 0 5"></TextBlock>
          <TextBox Grid.Row="6" Grid.Column="0" Name="txtDonViTinh" Style="{StaticResource InputTextBoxStyle}" Tag="Nhập đơn vị tính"
                   Text="{Binding SanPhamAdded.DonViTinh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Margin="25 5"></TextBox>

          <TextBlock Grid.Row="1" Grid.Column="1" Text="Giá nhập"
                     FontSize="15" FontWeight="Bold" Foreground="#FF125593"
                     FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="25 5 0 5"></TextBlock>
          <TextBox Grid.Row="2" Grid.Column="1" Name="txtGiaNhap" Style="{StaticResource InputTextBoxStyle}" Tag="Nhập giá nhập"
                   Text="{Binding SanPhamAdded.GiaNhap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Margin="25 5"></TextBox>

          <TextBlock Grid.Row="3" Grid.Column="1" Text="Giá bán"
                     FontSize="15" FontWeight="Bold" Foreground="#FF125593"
                     FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="25 5 0 5"></TextBlock>
          <TextBox Grid.Row="4" Grid.Column="1" Name="txtGiaBan" Style="{StaticResource InputTextBoxStyle}" Tag="Nhập giá bán"
                   Text="{Binding SanPhamAdded.GiaBan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Margin="25 5"></TextBox>

          <!--Button Thêm và đóng-->
          <Button Grid.Row="6" Grid.Column="1" x:Name="btnThemMoi" Width="165"
                  Style="{StaticResource MainButtonStyle}" 
                  HorizontalAlignment="Left" Margin="25 5"
                  Content="Thêm mới" Command="{Binding AddProductCommand}"></Button>
          <Button Grid.Row="6" Grid.Column="1" x:Name="btnCapNhat" Width="165"
                  Style="{StaticResource MainButtonStyle}" 
                  HorizontalAlignment="Left" Margin="25 5"
                  Content="Cập nhật" Command="{Binding UpdateProductCommand}"></Button>
          <Button Grid.Row="6" Grid.Column="1" Width="165"
                  Style="{StaticResource CloseButtonStyle}"
                  HorizontalAlignment="Right" Margin="25 5"
                  Content="Đóng"></Button>

     </Grid>
</Window>
