<Application x:Class="CNPMNC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CNPMNC"
             StartupUri="Views/VMainWindow.xaml">
    <Application.Resources>
          <Style x:Key="NavbarButtonStyle" TargetType="ToggleButton">
               <Setter Property="Foreground" Value="Black"/>
               <Setter Property="FontSize" Value="15"/>
               <Setter Property="FontWeight" Value="SemiBold"/>
               <Setter Property="FontFamily" Value="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"></Setter>
               <Setter Property="VerticalContentAlignment" Value="Center"/>
               <Setter Property="HorizontalContentAlignment" Value="Center"/>
               <Setter Property="HorizontalAlignment" Value="Stretch"/>
               <Setter Property="VerticalAlignment" Value="Stretch"/>
               <Setter Property="Background" Value="Transparent"/>
               <Setter Property="Template">
                    <Setter.Value>
                         <ControlTemplate TargetType="ToggleButton">
                              <Grid>
                                   <Border x:Name="Border" Background="Transparent"
                                           BorderBrush="LightGray">
                                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                   </Border>
                              </Grid>
                              <ControlTemplate.Triggers>
                                   <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#FF125593"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0 0 0 3"/>
                                        <Setter TargetName="Text" Property="Foreground" Value="#FF125593"/>
                                   </Trigger>
                                   <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#FF125593"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0 0 0 3"/>
                                        <Setter TargetName="Text" Property="Foreground" Value="#FF125593"/>
                                        <!-- Xám nhẹ -->
                                   </Trigger>
                                   <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                             <Condition Property="IsMouseOver" Value="True"/>
                                             <Condition Property="IsChecked" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="White"/>
                                   </MultiTrigger>
                              </ControlTemplate.Triggers>
                         </ControlTemplate>
                    </Setter.Value>
               </Setter>
          </Style>

          <Style x:Key="ChildItemButtonStyle" TargetType="ToggleButton">
               <Setter Property="Foreground" Value="Black"/>
               <Setter Property="FontSize" Value="15"/>
               <Setter Property="FontWeight" Value="SemiBold"/>
               <Setter Property="FontFamily" Value="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"></Setter>
               <Setter Property="VerticalContentAlignment" Value="Center"/>
               <Setter Property="HorizontalContentAlignment" Value="Center"/>
               <Setter Property="HorizontalAlignment" Value="Stretch"/>
               <Setter Property="VerticalAlignment" Value="Stretch"/>
               <Setter Property="Background" Value="Transparent"/>
               <Setter Property="Template">
                    <Setter.Value>
                         <ControlTemplate TargetType="ToggleButton">
                              <Grid>
                                   <Border x:Name="Border" Background="Transparent"
                                           BorderBrush="LightGray" BorderThickness="0 0 0 1">
                                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                   </Border>
                              </Grid>
                              <ControlTemplate.Triggers>
                                   <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#FF125593"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0 0 0 2"/>
                                        <Setter TargetName="Text" Property="Foreground" Value="#FF125593"/>
                                   </Trigger>
                                   <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#FF125593"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0 0 0 2"/>
                                        <Setter TargetName="Text" Property="Foreground" Value="#FF125593"/>
                                        <!-- Xám nhẹ -->
                                   </Trigger>
                                   <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                             <Condition Property="IsMouseOver" Value="True"/>
                                             <Condition Property="IsChecked" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="White"/>
                                   </MultiTrigger>
                              </ControlTemplate.Triggers>
                         </ControlTemplate>
                    </Setter.Value>
               </Setter>
          </Style>

          <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
               <Setter Property="FontSize" Value="13"/>
               <Setter Property="FontWeight" Value="SemiBold"/>
               <Setter Property="FontFamily" Value="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>
               <Setter Property="Foreground" Value="#FF125593"/>
               <Setter Property="Padding" Value="5"/>
               <Setter Property="BorderBrush" Value="#FF125593"/>
               <Setter Property="BorderThickness" Value="2"/>
               <Setter Property="VerticalContentAlignment" Value="Center"/>
               <Setter Property="Template">
                    <Setter.Value>
                         <ControlTemplate TargetType="TextBox">
                              <Border BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Background="{TemplateBinding Background}">
                                   <Grid>
                                        <!-- Nội dung nhập -->
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" />

                                        <!-- Placeholder -->
                                        <TextBlock x:Name="Placeholder" Text="Tìm kiếm ..."
                                                   Padding="{TemplateBinding Padding}" Foreground="Gray"
                                                   Opacity="0.6" IsHitTestVisible="False"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   FontFamily="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Visibility="Collapsed"/>
                                   </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                   <!-- Hiện placeholder khi Text rỗng -->
                                   <Trigger Property="Text" Value="">
                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                   </Trigger>

                                   <!-- Ẩn placeholder khi có focus (tránh nhấp nháy khi nhập nhanh) -->
                                   <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                                   </Trigger>
                              </ControlTemplate.Triggers>
                         </ControlTemplate>
                    </Setter.Value>
               </Setter>
          </Style>

          <Style x:Key="MainButtonStyle" TargetType="Button">
               <Setter Property="Background" Value="#FF125593"/>
               <Setter Property="FontSize" Value="13"/>
               <Setter Property="FontWeight" Value="SemiBold"/>
               <Setter Property="FontFamily" Value="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>
               <Setter Property="Foreground" Value="White"/>
               <Setter Property="BorderThickness" Value="0"/>
               <Setter Property="Padding" Value="8,4"/>
               <Setter Property="Cursor" Value="Hand"/>
               <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
               <Setter Property="Template">
                    <Setter.Value>
                         <ControlTemplate TargetType="Button">
                              <Border Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                                   <ContentPresenter HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     RecognizesAccessKey="True"/>
                              </Border>
                              <ControlTemplate.Triggers>
                                   <!-- Hover -->
                                   <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#FF125593"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="#FF125593"/>
                                   </Trigger>

                                   <!-- Click -->
                                   <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#FF125593"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="#FF125593"/>
                                   </Trigger>

                                   <!-- Disabled (optional) -->
                                   <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                   </Trigger>
                              </ControlTemplate.Triggers>
                         </ControlTemplate>
                    </Setter.Value>
               </Setter>
          </Style>

          <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
               <Setter Property="Foreground" Value="#FF125593"/>
               <Setter Property="Background" Value="White"/>
               <Setter Property="FontWeight" Value="SemiBold"/>
               <Setter Property="FontFamily" Value="/CNPMNC;component/Resources/Fonts/SpaceGrotesk/#Space Grotesk"/>
               <Setter Property="FontSize" Value="13"/>
               <Setter Property="BorderBrush" Value="#FF125593"/>
               <Setter Property="BorderThickness" Value="2,2,2,2"/>
               <Setter Property="Margin" Value="0 0 0 2"/>
               <Setter Property="Cursor" Value="Hand"/>
               <Setter Property="Width" Value="120"/>
               <Setter Property="Height" Value="25"/>
               <Setter Property="Template">
                    <Setter.Value>
                         <ControlTemplate TargetType="MenuItem">
                              <Border Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                                   <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <ControlTemplate.Triggers>
                                   <!-- Hover -->
                                   <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF125593"/>
                                        <Setter Property="Foreground" Value="White"/>
                                   </Trigger>
                                   <!-- Click -->
                                   <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FF125593"/>
                                        <Setter Property="Foreground" Value="White"/>
                                   </Trigger>
                                   <!-- Disabled -->
                                   <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                   </Trigger>
                              </ControlTemplate.Triggers>
                         </ControlTemplate>
                    </Setter.Value>
               </Setter>
          </Style>

          <Style x:Key="RoleBorderStyle" TargetType="Border">
               <Setter Property="CornerRadius" Value="5"/>
               <Setter Property="Background" Value="#FFF7F7F7" />
               <Setter Property="SnapsToDevicePixels" Value="True" />
               <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TextBlock}}" Value="Admin">
                         <Setter Property="Background" Value="#FFDE6767" />
                         <!-- đỏ nhạt -->
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TextBlock}}" Value="Phụ trách kho">
                         <Setter Property="Background" Value="#FF409067" />
                         <!-- xanh lá -->
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TextBlock}}" Value="Nhân viên">
                         <Setter Property="Background" Value="#DD025E86" />
                         <!-- xanh dương -->
                    </DataTrigger>
               </Style.Triggers>
          </Style>
     </Application.Resources>
</Application>
